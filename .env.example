# 실제 키 값은 이 파일에 적지 않는다. .env.local 에 채우고, 값은 팀 비밀 저장소에 보관한다.
# 이름 규약: WEB-11 코멘트(엄장헌, 2026-09-07). 자세한 설명은 docs/igdb.md
# 키 값은 대시보드에서 복사해 .env.local 에 직접 저장한다 — AI 채팅에 붙여넣지 않는다.

# Supabase — dev 프로젝트 (로컬·프리뷰·CI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# works 카탈로그 적재용. Settings → API Keys → Secret keys (sb_secret_...)
# 서버 전용 — NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다 (AGENTS.md 금지 규칙 5)
SUPABASE_SECRET_KEY=

# IGDB 인증은 Twitch 앱으로 한다 (dev.twitch.tv/console/apps) — T11
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
